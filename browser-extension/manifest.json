{
  "name": "DSH · 浏览器控制",
  "description": "将选中的网页共享给本机 DSH 模型，可以随时断开。",
  "version": "0.4.8",
  "manifest_version": 3,
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "tabGroups",
    "debugger"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://search.bilibili.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH 浏览器控制",
    "default_icon": {
      "16": "icons/dsh-16.png",
      "32": "icons/dsh-32.png",
      "48": "icons/dsh-48.png",
      "128": "icons/dsh-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/dsh-16.png",
    "32": "icons/dsh-32.png",
    "48": "icons/dsh-48.png",
    "128": "icons/dsh-128.png"
  },
  "minimum_chrome_version": "118"
}
